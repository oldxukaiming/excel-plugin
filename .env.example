# Optional access protection (when AUTH_PASSWORD is set, login is required for API calls)
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=

# Optional server-side API keys (leave empty to use free no-key mode)
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_ENDPOINT=
BING_TRANSLATOR_API_KEY=
BING_TRANSLATOR_REGION=

# Optional server port
PORT=3443
